{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray",
  "description": "Minimal command and window permissions for the menu-bar popover",
  "windows": ["tray"],
  "permissions": [
    "native-tray", "core:event:default",
    "core:window:allow-show", "core:window:allow-hide", "core:window:allow-is-visible",
    "core:window:allow-set-focus", "core:window:allow-unminimize", "core:window:allow-get-all-windows",
    "core:window:allow-set-size"
  ]
}
