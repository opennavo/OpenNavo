{
  "name": "@opennavo/api",
  "version": "0.0.0",
  "private": true,
  "description": "OpenNavo API types generated by openapi-typescript and public API client using openapi-fetch",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./public": {
      "types": "./src/public.d.ts"
    },
    "./admin": {
      "types": "./src/admin.d.ts"
    }
  },
  "scripts": {
    "gen": "openapi-typescript ../../apps/server/api/public.openapi.yaml -o src/public.d.ts && openapi-typescript ../../apps/server/api/admin.openapi.yaml -o src/admin.d.ts",
    "lint": "node ../../tooling/scripts/lint-frontend.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@opennavo/shared": "workspace:*",
    "openapi-fetch": "catalog:"
  },
  "devDependencies": {
    "openapi-typescript": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
